# WELCOME P0 — environment variables. Names only: never commit values.
# Copy to .env.local and fill in. See spec/implementation/ENVIRONMENT.md.

## Core
# development | production (db:reset / db:seed refuse to run in production)
APP_ENV=
# Absolute public base URL used to build public profile links and QR payloads
APP_BASE_URL=
# Postgres connection string
DATABASE_URL=
# Absolute base URL of the auth surface (may differ from APP_BASE_URL)
AUTH_BASE_URL=
# Base64 of exactly 32 random bytes; AES-256-GCM key encrypting contact_fields values at rest
ENCRYPTION_KEY=
# Pepper for HMAC-SHA256 lookups (email hash) and OTP hashing
HASH_PEPPER=
# debug | info | warn | error
LOG_LEVEL=

## Dev-only auth helper
# true → OTP verify response may include devCode when APP_ENV=development.
# NEVER set to true outside local development. Code goes to .runtime/otp.log otherwise.
AUTH_DEV_EXPOSE_OTP=true

## Telegram P0 (Phase: later)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

## Luma optional (Phase: later; only if the official webhook contract defines one)
LUMA_API_KEY=
LUMA_WEBHOOK_SECRET=

## WhatsApp optional (Phase: later)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

## LinkedIn optional (Phase: later)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

## Release/observability (optional; no NEXT_PUBLIC_ secrets allowed)
SENTRY_DSN=
