# WELCOME P0 — deploy environment (Vercel + managed EU Postgres).
# Names only: set the values in the Vercel dashboard (Project → Settings →
# Environment Variables), never in git. Mirrors .env.example; deploy-relevant subset.

# development | production — drives fail-closed behavior (src/lib/env.ts appEnv());
# must be "production" on Vercel
APP_ENV=
# Absolute public URL of the deployment (src/lib/env.ts appBaseUrl());
# Telegram webhook = APP_BASE_URL + /api/webhooks/telegram
APP_BASE_URL=
# Managed Postgres connection string (Neon/Supabase EU region, sslmode=require);
# used by the lazy singleton in src/lib/db.ts getSql()
DATABASE_URL=
# Base64 of exactly 32 random bytes — AES-256-GCM key encrypting contact values
# at rest (src/lib/env.ts requireEncryptionKey, src/lib/crypto.ts decodeEncryptionKey)
ENCRYPTION_KEY=
# Pepper for HMAC-SHA256 email lookup and OTP hashing, min 8 chars
# (src/lib/env.ts requireHashPepper)
HASH_PEPPER=
# Bot token from @BotFather; absent = channel disabled, never mocked in
# production (src/integrations/telegram/index.ts selectTransport)
TELEGRAM_BOT_TOKEN=
# Secret the bot sends in x-telegram-bot-api-secret-token; checked constant-time
# in src/app/api/webhooks/telegram/route.ts
TELEGRAM_WEBHOOK_SECRET=
# Bot username used to build deep links (src/integrations/telegram/index.ts
# telegramBotUsername)
TELEGRAM_BOT_USERNAME=
# Shared secret for POST|GET /api/internal/worker-tick (header x-worker-tick-secret
# or Authorization: Bearer — both constant-time). Unset in production → the
# endpoint answers 401 (fail-closed). Also set CRON_SECRET (Vercel dashboard) to
# the SAME value so scheduled cron invocations pass Authorization: Bearer.
# A `?secret=` query carrier was REMOVED (F-09): a secret in a URL leaks into
# access logs and Referer headers. It now answers 401, which usage-matrix P6 pins.
WORKER_TICK_SECRET=
# MUST be unset/false in production — dev-only OTP exposure, effective only when
# APP_ENV=development (src/lib/env.ts devExposeOtp)
AUTH_DEV_EXPOSE_OTP=
# Contact address the deployment PUBLISHES: the landing page's pilot CTA and the
# legal pages (src/lib/env.ts operatorContactEmail). There is no default — unset
# means no address is published and the pilot CTAs are not rendered at all.
OPERATOR_CONTACT_EMAIL=
# Where the legacy *.vercel.app redirects point. Defaults to APP_BASE_URL, which
# is already the canonical domain here; set explicitly so the intent is visible
# (src/lib/legacy-host-redirect.ts). LEGACY_REDIRECTS=off would drop the rules.
CANONICAL_ORIGIN=

# ── STAGING-TEST DEPLOYMENT ONLY — never enable on a real production deploy ──
# These two OTP-exposure switches exist so a staging-test deployment (which runs
# APP_ENV=production to exercise fail-closed behavior) can log in without an
# email provider. See docs-internal/adr/0009-dev-otp-exposure-staging.md.
#
# true → the OTP code is returned in the response for accounts flagged is_demo
# (synthetic seed accounts only; every other account is unaffected). Requires
# seeding: node scripts/seed-demo.mts. Unset/false on real production.
AUTH_EXPOSE_DEMO_OTP=
# true → master switch for the allowlist below; when live under APP_ENV=production
# the OTP route logs "DEV OTP EXPOSURE ENABLED ON PRODUCTION — staging-test only".
# Unset/false on real production.
AUTH_EXPOSE_OTP_EMAILS=
# Comma-separated addresses whose OTP may be returned (switch above must also be
# true). Used with AUTH_EXPOSE_OTP_EMAILS; unset on real production.
AUTH_EXPOSE_OTP_EMAIL_ALLOWLIST=
