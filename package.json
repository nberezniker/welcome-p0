{
  "name": "welcome-p0",
  "version": "0.1.0",
  "private": true,
  "description": "WELCOME P0 \u2014 persistent personal networking profile + reusable QR product (Phase 1)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node scripts/run-integration.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-reset.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.mts",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.mts",
    "scan:secrets": "node --env-file-if-exists=.env.local scripts/scan-secrets.mjs",
    "audit:deps": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": ">=8.5.18"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}